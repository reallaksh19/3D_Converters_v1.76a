<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="COADE"
           xmlns:ext="urn:reallaksh19:inputxml:extension:v1"
           targetNamespace="COADE"
           elementFormDefault="unqualified"
           attributeFormDefault="unqualified">
  <xs:import namespace="urn:reallaksh19:inputxml:extension:v1"
             schemaLocation="inputxml-extension-v1.xsd"/>

  <xs:annotation>
    <xs:documentation>
      Strict canonical InputXML v1. The CAESARII root is namespace-qualified
      with COADE; canonical engineering children are deliberately unqualified.
      Intake aliases and unrelated roots are not accepted.
    </xs:documentation>
  </xs:annotation>

  <xs:simpleType name="InputType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Input"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PositiveNodeIdType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PositiveDecimalType">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RestraintSlotType">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="6"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="BendType">
    <xs:attribute name="RADIUS" type="tns:PositiveDecimalType" use="required"/>
    <xs:attribute name="TYPE" type="xs:integer" use="optional"/>
    <xs:attribute name="ANGLE1" type="xs:decimal" use="optional"/>
    <xs:attribute name="NODE1" type="tns:PositiveNodeIdType" use="optional"/>
    <xs:attribute name="ANGLE2" type="xs:decimal" use="optional"/>
    <xs:attribute name="NODE2" type="tns:PositiveNodeIdType" use="optional"/>
    <xs:attribute name="ANGLE3" type="xs:decimal" use="optional"/>
    <xs:attribute name="NODE3" type="tns:PositiveNodeIdType" use="optional"/>
    <xs:attribute name="NUM_MITER" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="FITTINGTHICKNESS" type="xs:decimal" use="optional"/>
    <xs:attribute name="KFACTOR" type="xs:decimal" use="optional"/>
  </xs:complexType>

  <xs:complexType name="RigidType">
    <xs:attribute name="WEIGHT" type="xs:decimal" use="required"/>
  </xs:complexType>

  <xs:complexType name="SifType">
    <xs:attribute name="NODE" type="tns:PositiveNodeIdType" use="required"/>
  </xs:complexType>

  <xs:complexType name="RestraintType">
    <xs:attribute name="NUM" type="tns:RestraintSlotType" use="required"/>
    <xs:attribute name="NODE" type="tns:PositiveNodeIdType" use="required"/>
    <xs:attribute name="TYPE" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="STIFFNESS" type="xs:decimal" use="required"/>
    <xs:attribute name="GAP" type="xs:decimal" use="required"/>
    <xs:attribute name="FRIC_COEF" type="xs:decimal" use="required"/>
    <xs:attribute name="CNODE" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="XCOSINE" type="xs:decimal" use="required"/>
    <xs:attribute name="YCOSINE" type="xs:decimal" use="required"/>
    <xs:attribute name="ZCOSINE" type="xs:decimal" use="required"/>
    <xs:attribute name="TAG" type="xs:string" use="optional"/>
    <xs:attribute name="GUID" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="HangerType">
    <xs:attribute name="NODE" type="tns:PositiveNodeIdType" use="required"/>
    <xs:attribute name="STIFFNESS" type="xs:decimal" use="required"/>
    <xs:attribute name="LOAD_VAR" type="xs:decimal" use="required"/>
    <xs:attribute name="OPERATING_LOAD" type="xs:decimal" use="required"/>
    <xs:attribute name="RIGID_SUP" type="xs:decimal" use="required"/>
    <xs:attribute name="AVAIL_SPACE" type="xs:decimal" use="required"/>
    <xs:attribute name="COLD_LOAD" type="xs:decimal" use="required"/>
    <xs:attribute name="HOT_LOAD" type="xs:decimal" use="required"/>
    <xs:attribute name="MAX_TRAVEL" type="xs:decimal" use="required"/>
    <xs:attribute name="HARDWARE_WEIGHT" type="xs:decimal" use="required"/>
    <xs:attribute name="CONST_EFF_LOAD" type="xs:decimal" use="required"/>
    <xs:attribute name="MULTI_LC" type="xs:integer" use="required"/>
    <xs:attribute name="FREEANCHOR1" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="FREEANCHOR2" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="DOFTYPE1" type="xs:integer" use="required"/>
    <xs:attribute name="NUM_HGR" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="HGR_TABLE" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="SHORT_RANGE" type="xs:integer" use="required"/>
    <xs:attribute name="CNODE" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="TAG" type="xs:string" use="optional"/>
    <xs:attribute name="GUID" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="NozzleRecordType">
    <xs:attribute name="VALUE1" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE2" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE3" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE4" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE5" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE6" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE7" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE8" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE9" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE10" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE11" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE12" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE13" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE14" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE15" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE16" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE17" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE18" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE19" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE20" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE21" type="xs:decimal" use="required"/>
    <xs:attribute name="VALUE22" type="xs:decimal" use="required"/>
    <xs:attribute name="SOURCE_ENTITY_ID" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="PipingElementType">
    <xs:sequence>
      <xs:element name="BEND" type="tns:BendType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="RIGID" type="tns:RigidType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="SIF" type="tns:SifType" minOccurs="0" maxOccurs="2"/>
      <xs:element name="RESTRAINT" type="tns:RestraintType" minOccurs="0" maxOccurs="6"/>
      <xs:element name="HANGER" type="tns:HangerType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element ref="ext:Extension" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>

    <xs:attribute name="ID" type="xs:ID" use="required"/>
    <xs:attribute name="FROM_NODE" type="tns:PositiveNodeIdType" use="required"/>
    <xs:attribute name="TO_NODE" type="tns:PositiveNodeIdType" use="required"/>
    <xs:attribute name="DELTA_X" type="xs:decimal" use="required"/>
    <xs:attribute name="DELTA_Y" type="xs:decimal" use="required"/>
    <xs:attribute name="DELTA_Z" type="xs:decimal" use="required"/>
    <xs:attribute name="DIAMETER" type="tns:PositiveDecimalType" use="optional"/>
    <xs:attribute name="WALL_THICK" type="xs:decimal" use="optional"/>
    <xs:attribute name="INSUL_THICK" type="xs:decimal" use="optional"/>
    <xs:attribute name="CORR_ALLOW" type="xs:decimal" use="optional"/>
    <xs:attribute name="TEMP_EXP_C1" type="xs:decimal" use="optional"/>
    <xs:attribute name="TEMP_EXP_C2" type="xs:decimal" use="optional"/>
    <xs:attribute name="TEMP_EXP_C3" type="xs:decimal" use="optional"/>
    <xs:attribute name="TEMP_EXP_C4" type="xs:decimal" use="optional"/>
    <xs:attribute name="TEMP_EXP_C5" type="xs:decimal" use="optional"/>
    <xs:attribute name="TEMP_EXP_C6" type="xs:decimal" use="optional"/>
    <xs:attribute name="TEMP_EXP_C7" type="xs:decimal" use="optional"/>
    <xs:attribute name="TEMP_EXP_C8" type="xs:decimal" use="optional"/>
    <xs:attribute name="TEMP_EXP_C9" type="xs:decimal" use="optional"/>
    <xs:attribute name="PRESSURE_C1" type="xs:decimal" use="optional"/>
    <xs:attribute name="PRESSURE_C2" type="xs:decimal" use="optional"/>
    <xs:attribute name="PRESSURE_C3" type="xs:decimal" use="optional"/>
    <xs:attribute name="PRESSURE_C4" type="xs:decimal" use="optional"/>
    <xs:attribute name="PRESSURE_C5" type="xs:decimal" use="optional"/>
    <xs:attribute name="PRESSURE_C6" type="xs:decimal" use="optional"/>
    <xs:attribute name="PRESSURE_C7" type="xs:decimal" use="optional"/>
    <xs:attribute name="PRESSURE_C8" type="xs:decimal" use="optional"/>
    <xs:attribute name="PRESSURE_C9" type="xs:decimal" use="optional"/>
    <xs:attribute name="HYDRO_PRESSURE" type="xs:decimal" use="optional"/>
    <xs:attribute name="INSUL_DENSITY" type="xs:decimal" use="optional"/>
    <xs:attribute name="FLUID_DENSITY" type="xs:decimal" use="optional"/>
    <xs:attribute name="MATERIAL_NUM" type="xs:integer" use="optional"/>
    <xs:attribute name="FROM_NAME" type="xs:string" use="optional"/>
    <xs:attribute name="TO_NAME" type="xs:string" use="optional"/>
    <xs:attribute name="LINE" type="xs:string" use="required"/>
    <xs:attribute name="FROM_X" type="xs:decimal" use="optional"/>
    <xs:attribute name="FROM_Y" type="xs:decimal" use="optional"/>
    <xs:attribute name="FROM_Z" type="xs:decimal" use="optional"/>
    <xs:attribute name="TO_X" type="xs:decimal" use="optional"/>
    <xs:attribute name="TO_Y" type="xs:decimal" use="optional"/>
    <xs:attribute name="TO_Z" type="xs:decimal" use="optional"/>
  </xs:complexType>

  <xs:complexType name="PipingModelType">
    <xs:sequence>
      <xs:element name="PIPINGELEMENT" type="tns:PipingElementType" minOccurs="1" maxOccurs="unbounded"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="WRC_297_NOZZLE" type="tns:NozzleRecordType"/>
        <xs:element name="API650_NOZZLE" type="tns:NozzleRecordType"/>
        <xs:element name="PD5500_NOZZLE" type="tns:NozzleRecordType"/>
        <xs:element name="CUSTOM_NOZZLE" type="tns:NozzleRecordType"/>
      </xs:choice>
      <xs:element ref="ext:Extension" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>

    <xs:attribute name="JOBNAME" type="xs:string" use="required"/>
    <xs:attribute name="TIME" type="xs:string" use="optional"/>
    <xs:attribute name="ISSUE_NO" type="xs:string" use="optional"/>
    <xs:attribute name="NUMELT" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMNOZ" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NOHGRS" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMBEND" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMRIGID" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMEXPJNT" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMREST" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMFORCMNT" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMUNFLOAD" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMWIND" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMELEOFF" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMALLOW" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NUMISECT" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="NORTH_X" type="xs:decimal" use="required"/>
    <xs:attribute name="NORTH_Y" type="xs:decimal" use="required"/>
    <xs:attribute name="NORTH_Z" type="xs:decimal" use="required"/>
  </xs:complexType>

  <xs:complexType name="CaesarInputType">
    <xs:sequence>
      <xs:element name="PIPINGMODEL" type="tns:PipingModelType" minOccurs="1" maxOccurs="1"/>
      <xs:element ref="ext:Extension" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="VERSION" type="xs:string" use="required"/>
    <xs:attribute name="XML_TYPE" type="tns:InputType" use="required"/>
  </xs:complexType>

  <xs:element name="CAESARII" type="tns:CaesarInputType"/>
</xs:schema>
